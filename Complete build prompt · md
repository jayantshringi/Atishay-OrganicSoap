    const { orderId } = req.params;
    const { orderStatus, trackingNumber } = req.body;

    if (!orderStatus) {
      return res.status(400).json({ error: 'Status required' });
    }

    const order = await prisma.order.update({
      where: { id: orderId },
      data: {
        orderStatus,
        trackingNumber: trackingNumber || null
      },
      include: { user: true }
    });

