# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soap_db?schema=public"

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRY=30d

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Email Delivery (Gmail / SendGrid)
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASSWORD=your_app_password
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=noreply@yoursoap.com

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Admin Config
ADMIN_EMAIL=admin@yoursoap.com
