  const currentStatusIndex = statuses.findIndex((s) => s.status === order.orderStatus);

  return (
    <div className="max-w-4xl mx-auto my-10 p-6">
      <button
        onClick={() => router.back()}
        className="text-primary font-bold mb-6 hover:underline"
      >
        ← Back
      </button>

      <div className="bg-white rounded-lg shadow p-6 mb-6">
        <h1 className="text-3xl font-poppins font-bold text-primary mb-2">
          Order #{order.id.slice(0, 8)}
        </h1>
        <p className="text-gray-600">Placed on {new Date(order.createdAt).toLocaleDateString()}</p>
      </div>

      {/* Customization Details */}
      <div className="bg-neutral rounded-lg p-6 mb-6">
        <h2 className="text-xl font-bold mb-4">Your Customization</h2>
        <div className="grid grid-cols-2 gap-4">
          <div>
            <p className="text-gray-600 text-sm">Skin Type</p>
            <p className="font-bold">{order.skinType}</p>
          </div>
          <div>
            <p className="text-gray-600 text-sm">Main Concern</p>
            <p className="font-bold">{order.mainConcern}</p>
          </div>
          <div>
            <p className="text-gray-600 text-sm">Soap Texture</p>
            <p className="font-bold">{order.texturePreference}</p>
          </div>
          {order.recipe && (
            <div>
              <p className="text-gray-600 text-sm">Recipe</p>
              <p className="font-bold">{order.recipe.name}</p>
            </div>
          )}
        </div>
      </div>

      {/* Timeline */}
      <div className="bg-white rounded-lg shadow p-6 mb-6">
        <h2 className="text-xl font-bold mb-6">Order Timeline</h2>
        <div className="space-y-4">
          {statuses.map((item, index) => (
            <div key={item.status} className="flex items-start">
              <div className="flex flex-col items-center">
                <div
                  className={`w-10 h-10 rounded-full flex items-center justify-center text-lg font-bold ${
                    index <= currentStatusIndex
                      ? 'bg-green-500 text-white'
                      : 'bg-gray-300 text-gray-600'
                  }`}
                >
                  {item.icon}
                </div>
                {index < statuses.length - 1 && (
                  <div
                    className={`w-1 h-12 ${
                      index < currentStatusIndex ? 'bg-green-500' : 'bg-gray-300'
                    }`}
                  ></div>
                )}
              </div>
              <div className="ml-6 pt-2">
                <p className="font-bold">{item.label}</p>
                {index <= currentStatusIndex && (
                  <p className="text-sm text-gray-600">
                    {index === currentStatusIndex
                      ? 'In progress'
                      : 'Completed'}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Delivery Info */}
      <div className="bg-white rounded-lg shadow p-6">
        <h2 className="text-xl font-bold mb-4">Delivery Information</h2>
        <div className="space-y-2 text-sm">
          <p>
            <strong>Address:</strong> {order.deliveryAddress}
          </p>
          <p>
            <strong>City:</strong> {order.deliveryCity}
          </p>
          <p>
            <strong>Postal Code:</strong> {order.deliveryPostalCode}
          </p>
          <p>
            <strong>Phone:</strong> {order.deliveryPhone}
          </p>
          <p>
            <strong>Expected Delivery:</strong>{' '}
            {new Date(order.deliveryDate).toLocaleDateString()}
          </p>
          {order.trackingNumber && (
            <p>
              <strong>Tracking Number:</strong> {order.trackingNumber}
            </p>
          )}
        </div>
      </div>
    </div>
  );
}
