'use client';

import { useEffect, useState } from 'react';
import { useRouter, useSearchParams } from 'next/navigation';
import { ordersAPI, paymentsAPI } from '@/services/api';

export default function OrderConfirmationPage() {
  const searchParams = useSearchParams();
  const router = useRouter();
  const orderId = searchParams.get('orderId');

  const [order, setOrder] = useState(null);
  const [loading, setLoading] = useState(true);
  const [paymentProcessing, setPaymentProcessing] = useState(false);

  useEffect(() => {
    const fetchOrder = async () => {
      try {
        const response = await ordersAPI.getById(orderId);
        setOrder(response.data);
      } catch (err) {
        console.error(err);
      } finally {
        setLoading(false);
      }
    };

    if (orderId) {
      fetchOrder();
    }
  }, [orderId]);

  const handlePayment = async () => {
    setPaymentProcessing(true);

    try {
      // Step 1: Create Razorpay order
      const orderRes = await paymentsAPI.createOrder({
        orderId: order.id,
        amount: order.price,
      });

      const razorpayOrderId = orderRes.data.razorpayOrderId;

      // Step 2: Open Razorpay checkout
      const options = {
        key: process.env.NEXT_PUBLIC_RAZORPAY_KEY,
        amount: order.price * 100,
        currency: 'INR',
        name: 'SoapCo',
        description: `Custom Soap Order #${order.id}`,
        order_id: razorpayOrderId,
        prefill: {
          email: localStorage.getItem('userEmail'),
          contact: order.deliveryPhone,
        },
        handler: async (response) => {
          try {
            // Step 3: Verify payment
            await paymentsAPI.verify({
              razorpay_order_id: response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature: response.razorpay_signature,
              orderId: order.id,
            });

            router.push(`/thank-you?orderId=${order.id}`);
          } catch (err) {
            alert('Payment verification failed. Please contact support.');
          }
        },
        theme: {
          color: '#D4AF37',
        },
      };

      const rzp = new window.Razorpay(options);
      rzp.open();
    } catch (err) {
      alert('Payment failed. Please try again.');
    } finally {
      setPaymentProcessing(false);
    }
  };

  if (loading) return <div className="text-center py-20">Loading...</div>;
  if (!order) return <div className="text-center py-20">Order not found</div>;

  return (
    <div className="max-w-2xl mx-auto my-10 p-6 bg-white rounded-lg shadow">
      <h1 className="text-3xl font-poppins font-bold text-primary mb-6">
        Order Summary
      </h1>

      <div className="border-2 border-accent p-6 rounded-lg mb-6 bg-neutral">
        <h2 className="text-xl font-bold mb-4">Your Custom Soap</h2>

        <div className="space-y-3">
          <p>
            <strong>Skin Type:</strong> {order.skinType}
          </p>
          <p>
            <strong>Main Concern:</strong> {order.mainConcern}
          </p>
          <p>
            <strong>Soap Texture:</strong> {order.texturePreference}
          </p>
          {order.recipe && (
            <p>
              <strong>Recipe:</strong> {order.recipe.name}
            </p>
          )}
          <p>
            <strong>Expected Delivery:</strong>{' '}
            {new Date(order.deliveryDate).toLocaleDateString()}
          </p>
        </div>
      </div>

      <div className="bg-gray-50 p-6 rounded-lg mb-6">
        <div className="flex justify-between items-center mb-4">
          <span className="text-lg font-bold">Price:</span>
          <span className="text-2xl font-bold text-accent">₹{order.price}</span>
        </div>

        <div className="bg-yellow-50 border border-yellow-200 p-4 rounded mb-6">
          <p className="text-sm text-gray-700">
            ⚠️ <strong>Patch test recommended!</strong> Apply a small amount on your inner arm and wait 24 hours to check for any irritation.
          </p>
